# ─── Required ─────────────────────────────────────────────────
# Neon PostgreSQL connection string
# Get from: neon.tech > Your Project > Connection String
DATABASE_URL=postgresql://username:password@host.neon.tech/neondb?sslmode=require

# Anthropic API key
# Get from: console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Optional ─────────────────────────────────────────────────
# Application name (displayed in browser tab)
VITE_APP_NAME=PGOS

# ─── DO NOT add to this file ──────────────────────────────────
# - Never commit secrets to git
# - In Vercel: Settings > Environment Variables
# - DATABASE_URL and ANTHROPIC_API_KEY are server-only (no VITE_ prefix)
# - VITE_ prefix = exposed to browser bundle
